# Version control
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.mypy_cache/
.pytest_cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# Large/external data files. The full SOLETE dataset is mounted at runtime (see
# data/README.md) -- but the small sample files in examples/ (~9 KB) are kept,
# since scripts/quickstart/RunMe.py reads one by default.
*.h5
!examples/*.h5
*.hdf5
*.csv
*.mat
data/
outputs/

# Editors / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
