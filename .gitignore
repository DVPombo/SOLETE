# ---- Data: lives on figshare (https://doi.org/10.11583/DTU.17040767), never in git ----
# data/ is the folder where users put the figshare files; only its README is tracked.
data/*
!data/README.md
!data/build_summary_v4.json
!data/manifest.json
!data/figshare_README.txt
!data/SOLETE_Pombo_v4_RESAMPLING_METHODOLOGY.md
!data/hdf5/
data/hdf5/*
!data/hdf5/.gitkeep
!data/parquet/
data/parquet/*
!data/parquet/.gitkeep
*.parquet
*.zip
*.csv.gz
# The tiny samples in examples/ ARE tracked:
!examples/*.h5

# ---- Generated by the code ----
outputs/
*_Expanded.h5
Trained_*
Results_*.h5
*_METHODOLOGY.md
!dataset/docs/METHODOLOGY.md

# ---- Python / tooling ----
__pycache__/
*.py[cod]
*.egg-info/
.env
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.coverage

# ---- Editors / OS ----
.vscode/
.idea/
.spyproject/
.DS_Store
Thumbs.db
